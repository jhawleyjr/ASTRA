# - a `;` inside a `# comment` after a pipeline `|` is still just comment text in real bash, but
#   this scanner's quote/comment-unaware separator scan treats it as a real statement boundary,
#   severing the pipeline-adjacency chain the same way an un-commented `;` legitimately would
0	{"cwd":"$ROOT","tool_name":"Bash","tool_input":{"command":"cd tests/golden; printf x | # note;\ncd ../..; printf x > probe.hpp"}}
