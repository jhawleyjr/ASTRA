# One case per line: <expected exit>\t<JSON piped to no-main.sh on stdin>. $ROOT is the repo root; the runner must
# execute these with HEAD on main for the "on main" cases (use a throwaway clone or `git -C` a temp repo).
0	{"cwd":"$ROOT","tool_input":{"command":"git push -u origin worktree-m0"}}
0	{"cwd":"$ROOT","tool_input":{"command":"git status"}}
0	{"cwd":"$ROOT","tool_input":{"command":"just check"}}
0	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -m x"}}
0	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git rebase main"}}
2	{"cwd":"$ROOT","tool_input":{"command":"git push origin main"}}
2	{"cwd":"$ROOT","tool_input":{"command":"git push -u origin HEAD:main"}}
2	{"cwd":"$ROOT_ON_MAIN","tool_input":{"command":"git commit -m x"}}
2	{"cwd":"$ROOT_ON_MAIN","tool_input":{"command":"git merge worktree-task"}}
2	{"cwd":"$ROOT_ON_MAIN","tool_input":{"command":"git rebase worktree-task"}}
2	{"cwd":"$ROOT_ON_MAIN","tool_input":{"command":"git reset --hard HEAD~1"}}
# Rule 3: no co-author trailer in a commit message, whichever way the message arrives (-m, a heredoc in the
# command text, an -F/--file file read relative to the hook's cwd or to `git -C <dir>`, or --trailer).
# BLOCK: a second -m paragraph that is the trailer
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -m \"subject\" -m \"Co-Authored-By: Claude <noreply@anthropic.com>\""}}
# BLOCK: the trailer in a heredoc, as -m "$(cat <<'EOF' ...)" and, lowercase, as -F - <<'EOF'
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -m \"$(cat <<'EOF'\nsubject\n\nbody\n\nCo-Authored-By: Claude <noreply@anthropic.com>\nEOF\n)\""}}
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -F - <<'EOF'\nsubject\n\nco-authored-by: Claude <noreply@anthropic.com>\nEOF"}}
# BLOCK: an -F/--file file holding the trailer, by every spelling of the option
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -F msg-trailer.txt"}}
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -Fmsg-trailer.txt"}}
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -aF msg-trailer.txt"}}
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit --file msg-trailer.txt"}}
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit --file=$ROOT_ON_BRANCH/msg-trailer.txt"}}
# BLOCK: an -F file the hook cannot read or cannot name (missing, or behind a variable) is unverifiable
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -F missing.txt"}}
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -F \"$MSG\""}}
# BLOCK: --trailer with a co-author key
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit --trailer \"Co-authored-by: X <x@example.invalid>\" -m subject"}}
# BLOCK: `git -C sub` makes a relative -F path resolve under sub/ (sub/msg-c.txt has the trailer; the
# msg-c.txt in cwd does not), and a -C the hook cannot resolve refuses a relative -F path
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git -C sub commit -F msg-c.txt"}}
2	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git -C \"$D\" commit -F msg-clean.txt"}}
# PASS: no trailer, by -m, heredoc and -F (only-sub.txt exists only under sub/, so that case passes only when
# the path resolves against -C); a mid-line mention in prose is not a trailer; reading trailers is not a commit
0	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -m \"subject\" -m \"body\""}}
0	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -m \"$(cat <<'EOF'\nsubject\n\nbody\nEOF\n)\""}}
0	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -F msg-clean.txt"}}
0	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -F msg-c.txt"}}
0	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git -C sub commit -F only-sub.txt"}}
0	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git -C sub commit -F $ROOT_ON_BRANCH/msg-clean.txt"}}
0	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git commit -m \"Refuse a Co-Authored-By trailer in commit messages\""}}
0	{"cwd":"$ROOT_ON_BRANCH","tool_input":{"command":"git log origin/main..HEAD --format='%(trailers:key=Co-authored-by)'"}}
# Documented gaps (not checked): -C/-c/--amend --no-edit reuse an existing message; an inline `cd` before
# `git commit -F <relative>` is not followed (the file is looked up from the hook's cwd, so it is usually
# refused as missing); a later statement that merely prints a trailer-shaped line is false-blocked (safe).
