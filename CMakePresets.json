{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug, no sanitizers",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Debug + ASan/UBSan (the gate)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "ASTRA_SANITIZERS": "address,undefined" }
    },
    {
      "name": "static-plugins",
      "inherits": "asan",
      "displayName": "ASan/UBSan with every plugin linked into libastra_core (no dlopen)",
      "cacheVariables": { "ASTRA_STATIC_PLUGINS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "static-plugins", "configurePreset": "static-plugins" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "static-plugins", "configurePreset": "static-plugins", "output": { "outputOnFailure": true } }
  ]
}
