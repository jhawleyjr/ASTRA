# Writes OUTPUT, the C++ source behind core/include/astra/build_info.hpp (ADR-0025 Q10), and rewrites
# it only when its text changes, so an unchanged tree recompiles and relinks nothing. Run at every
# build by the astra_build_info target (core/CMakeLists.txt) with -DGIT_EXECUTABLE, -DSOURCE_DIR,
# -DVERSION and -DOUTPUT. A build outside a git checkout, or without git, records "unknown".
set(describe "unknown")
if(GIT_EXECUTABLE)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" describe --always --dirty
    WORKING_DIRECTORY "${SOURCE_DIR}"
    RESULT_VARIABLE result
    OUTPUT_VARIABLE output
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET)
  if(result EQUAL 0 AND output MATCHES "^[A-Za-z0-9._/-]+$")
    set(describe "${output}")
  endif()
endif()
set(content "// Generated by cmake/astra_build_info.cmake at build time; do not edit.
#include \"astra/build_info.hpp\"

namespace astra {

const char* git_describe() noexcept { return \"${describe}\"; }

const char* core_version() noexcept { return \"${VERSION}\"; }

}  // namespace astra
")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
  if(previous STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
