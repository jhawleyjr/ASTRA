== the script (scratchpad, not committed)
"""M6 PR 8 before/after check (docs/plans/m6-pr8-report.md, step 3).

svg_bytes and scenario.evaluate must not change what they replace. The same inputs are rendered and
verified twice: by the main checkout's venv (source at 51410e2) and by the worktree's (the branch).

    python before_after.py tree MAIN_ROOT LS_TREE_FILE     # main's tree equals 51410e2, no extra source
    python before_after.py inputs DIR                      # once: scenario logs, the descent batch
    python before_after.py outputs DIR OUT                 # per venv, cwd = that venv's repo root
    python before_after.py compare BEFORE AFTER
"""

from __future__ import annotations

import dataclasses
import filecmp
import hashlib
import json
import math
import sys
from pathlib import Path

SCENARIOS = ("aileron_step", "atmosphere_ceiling_halt", "cruise_hold", "elevator_step", "throttle_step")
PLOT_LOGS = ("elevator_step", "atmosphere_ceiling_halt")
PACKAGES = (
    "flight",
    "attitude",
    "health",
    "aircraft/_template/plots/controls.yaml",
    "aircraft/_template/plots/wrench.yaml",
    "aircraft/_template/plots/ground_track.yaml",
    "aircraft/notional_transport/plots/cruise.yaml",
)
SOURCE_DIRS = ("python", "tests", "aircraft", "plugins", "core", "scripts", "icd", "embedded")
GENERATED = ("__pycache__", ".pyc", "python/astra/_core.pyi", "python/compile_commands.json")


def tree(main_root: Path, ls_tree: Path) -> None:
    tracked: dict[str, str] = {}
    for line in ls_tree.read_text().splitlines():
        meta, path = line.split("\t", 1)
        _mode, kind, sha = meta.split()
        if kind == "blob":
            tracked[path] = sha
    differ = []
    for path, sha in tracked.items():
        file = main_root / path
        if file.is_symlink():
            data = str(file.readlink()).encode()
        elif file.is_file():
            data = file.read_bytes()
        else:
            differ.append(f"missing {path}")
            continue
        blob = hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()
        if blob != sha:
            differ.append(f"modified {path}")
    extra = []
    for top in SOURCE_DIRS:
        for file in sorted((main_root / top).rglob("*")):
            rel = file.relative_to(main_root).as_posix()
            if file.is_dir() or rel in tracked or any(g in rel for g in GENERATED):
                continue
            extra.append(rel)
    print(f"tracked blobs compared: {len(tracked)}; differing: {len(differ)}")
    for item in differ:
        print(f"  {item}")
    print(f"untracked files under {', '.join(SOURCE_DIRS)} (generated caches aside): {len(extra)}")
    for item in extra:
        print(f"  {item}")
    assert not differ and not extra, "the main checkout is not a clean 51410e2 tree"
    print("main checkout: clean 51410e2 tree")


def inputs(out: Path) -> None:
    from astra import montecarlo, scenario

    out.mkdir(parents=True)
    for name in SCENARIOS:
        loaded = scenario.load(f"tests/scenarios/{name}.yaml", root=".")
        result = scenario.run(loaded, out / f"{name}.h5")
        print(f"{name}: frames {result.log.frames_run}, failures {len(result.failures)}")
    montecarlo.run(
        montecarlo.load("tests/python/mc_analysis_fixtures/descent_batch.yaml", root="."),
        out / "descent",
    )
    print("descent batch written")


def _tightened(path: Path, out: Path) -> Path:
    import yaml

    data = yaml.safe_load(path.read_text())
    for check in data.get("checks", []):
        if "within" in check:
            check["within"]["tol"] = 0.0
        if "angle_within" in check:
            check["angle_within"]["tol"] = 0.0
        if "between" in check:
            check["between"]["hi"] = check["between"]["lo"]
    target = out / f"{path.stem}_tight.yaml"
    target.write_text(yaml.safe_dump(data))
    return target


def _messages(inputs_dir: Path, out: Path) -> dict[str, list[str]]:
    import numpy as np

    from astra import log, scenario

    messages: dict[str, list[str]] = {}
    variants = out / "variants"
    variants.mkdir()
    for name in SCENARIOS:
        source = Path(f"tests/scenarios/{name}.yaml")
        run_log = log.load(inputs_dir / f"{name}.h5")
        messages[name] = scenario.verify(scenario.load(source, root="."), run_log)
        tight = scenario.load(_tightened(source, variants), root=".")
        messages[f"{name} tightened"] = scenario.verify(tight, run_log)
    # elevator_step's check (v0.derived.q over [1.1, 1.5) s) on two altered copies of its log:
    # a NaN in the window (the worst value is NaN), and the window missing one row.
    base = scenario.load("tests/scenarios/elevator_step.yaml", root=".")
    run_log = log.load(inputs_dir / "elevator_step.h5")
    divisor, table = next((d, t) for d, t in run_log.rates.items() if "v0.derived.q" in t.columns)
    with_nan = table.copy()
    with_nan.loc[1200, "v0.derived.q"] = math.nan
    messages["elevator_step NaN"] = scenario.verify(
        base, dataclasses.replace(run_log, rates={**run_log.rates, divisor: with_nan})
    )
    short = table.drop(index=1300)
    messages["elevator_step missing row"] = scenario.verify(
        base, dataclasses.replace(run_log, rates={**run_log.rates, divisor: short})
    )
    messages["elevator_step signal absent"] = scenario.verify(
        base,
        dataclasses.replace(
            run_log, rates={**run_log.rates, divisor: table.drop(columns=["v0.derived.q"])}
        ),
    )
    assert np.isnan(with_nan.loc[1200, "v0.derived.q"])
    return messages


def outputs(inputs_dir: Path, out: Path) -> None:
    import astra
    from astra import cli

    out.mkdir(parents=True)
    print(f"astra imported from {astra.__file__}")
    count = 0
    for name in PLOT_LOGS:
        for package in PACKAGES:
            code = cli.main(["plot", str(inputs_dir / f"{name}.h5"), package, "--out", str(out / name)])
            assert code == 0, (name, package, code)
        count += len(list((out / name).iterdir()))
    for label, extra in (("default", []), ("metric", ["--metric", "max.v0.derived.altitude"])):
        code = cli.main(
            ["mc", "analyze", str(inputs_dir / "descent"), "--signal", "v0.derived.altitude",
             "--signal", "v0.slow_rate.value", "--out", str(out / f"mc-{label}"), *extra]
        )
        assert code == 0, (label, code)
        count += len(list((out / f"mc-{label}").iterdir()))
    messages = _messages(inputs_dir, out)
    (out / "verify.json").write_text(json.dumps(messages, indent=1, sort_keys=True))
    print(f"figure files: {count}; verify cases: {len(messages)}; messages: "
          f"{sum(len(v) for v in messages.values())}")


def compare(before: Path, after: Path) -> None:
    files = sorted(p.relative_to(before) for p in before.rglob("*") if p.is_file() and "variants" not in p.parts)
    other = sorted(p.relative_to(after) for p in after.rglob("*") if p.is_file() and "variants" not in p.parts)
    assert files == other, sorted(set(files) ^ set(other))
    differ = [str(p) for p in files if not filecmp.cmp(before / p, after / p, shallow=False)]
    figures = [p for p in files if p.suffix in (".svg", ".png")]
    print(f"files compared: {len(files)} ({len(figures)} figures, verify.json); differing: {len(differ)}")
    for p in differ:
        print(f"  differs: {p}")
    a = json.loads((before / "verify.json").read_text())
    b = json.loads((after / "verify.json").read_text())
    print(f"verify cases: {len(a)}; messages before {sum(map(len, a.values()))}, after {sum(map(len, b.values()))}")
    for case in sorted(a):
        print(f"  {case}: {len(a[case])} message(s), {'equal' if a[case] == b.get(case) else 'DIFFERENT'}")
    assert not differ and a == b
    print("before/after: identical")


if __name__ == "__main__":
    mode = sys.argv[1]
    if mode == "tree":
        tree(Path(sys.argv[2]), Path(sys.argv[3]))
    elif mode == "inputs":
        inputs(Path(sys.argv[2]))
    elif mode == "outputs":
        outputs(Path(sys.argv[2]), Path(sys.argv[3]))
    else:
        compare(Path(sys.argv[2]), Path(sys.argv[3]))
